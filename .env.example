# Copy to .env.local for local dev. On Vercel: Project > Settings > Environment Variables.

# Required for the full voice agent (free key: https://aistudio.google.com/apikey).
# Without it, Vaani runs in offline mode (browser speech + built-in commands).
GEMINI_API_KEY=

# Live model id. Check the current one at https://ai.google.dev/gemini-api/docs/models
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: a prebuilt Gemini voice name. Leave empty for the model default.
GEMINI_LIVE_VOICE=

# Shown to the agent so it speaks prices with the same currency as the dashboard.
VOICE_CURRENCY=$
VOICE_STORE_NAME=DukaanSe
